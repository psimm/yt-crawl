{#
  Expected context (all values are JSON-serializable mappings/lists):

  dashboard = {
    "generated_at": str,
    "run": {
      "id": str, "status": "started|ready_to_resume|completed|stopped_budget|failed",
      "topic_query": str, "language": str, "start_date": str,
      "started_at": str, "completed_at": str|None, "duration": str,
      "model": str, "prompt_version": str, "prompt_sha256": str|None
    },
    "metrics": {
      "queries": int, "channels": int, "candidates": int,
      "relevant": int, "irrelevant": int, "transcripts": int,
      "cache_hits": int, "pending": int, "errors": int
    },
    "budgets": [{
      "label": str, "used": number, "limit": number, "remaining": number,
      "reserved": number|None, "percent": number, "unit": str,
      "tone": "blue|teal|amber"
    }],
    "funnel": [{"label": str, "count": int, "percent": number, "hint": str}],
    "provenance": [{
      "source": str, "count": int, "relevant": int, "percent": number
    }],
    "queries": [{
      "query": str, "kind": str, "status": str, "results": int,
      "relevant": int
    }],
    "relevant_videos": [video], "irrelevant_videos": [video],
    "other_videos": [video],
    # video = {
    #   "id": str, "title": str, "url": str|None, "channel": str,
    #   "published_at": str, "discovered_via": str,
    #   "decision_point": str, "primary_reason": str,
    #   "language": str|None, "reason": str,
    #   "transcript_status": "available|unavailable|not_requested"
    # }
    "transcript": {
      "eligible": int, "available": int, "unavailable": int,
      "coverage_percent": number, "segments": int, "words": int,
      "items": [{
        "video_id": str, "title": str, "status": str, "language": str|None,
        "segments": int, "words": int, "reason": str|None
      }]
    },
    "errors": [{"recorded_at": str, "stage": str, "message": str, "ref": str|None}],
    "continuation": {
      "action": "resume|expand|recover", "controls": mapping,
      "resume_command": str|None, "sessions": [mapping],
      "recommendation_reason": str,
      "deferred_videos": int, "executed_queries": int,
      "deferred_queries": int, "unfinished_queries": int,
      "checkpoint_available": bool, "checkpoint_message": str|None
    },
    "paths": {
      "run_dir": str, "database": str|None,
      "jsonl_files": [{"name": str, "path": str, "rows": int, "bytes": str}]
    }
  }
#}
{% set run = dashboard.run | default({}) %}
{% set metrics = dashboard.metrics | default({}) %}
{% set budgets = dashboard.budgets | default([], true) %}
{% set funnel = dashboard.funnel | default([], true) %}
{% set provenance = dashboard.provenance | default([], true) %}
{% set queries = dashboard.queries | default([], true) %}
{% set relevant_videos = dashboard.relevant_videos | default([], true) %}
{% set irrelevant_videos = dashboard.irrelevant_videos | default([], true) %}
{% set other_videos = dashboard.other_videos | default([], true) %}
{% set transcript = dashboard.transcript | default({}) %}
{% set transcript_items = transcript.get('items', []) %}
{% set errors = dashboard.errors | default([], true) %}
{% set continuation = dashboard.continuation | default({}) %}
{% set sessions = continuation.sessions | default([], true) %}
{% set paths = dashboard.paths | default({}) %}
{% set jsonl_files = paths.jsonl_files | default([], true) %}
{% set status = run.status | default('unknown', true) %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ run.topic_query | default('Crawler run', true) | e }} · YouTube research</title>
  <style>
    :root {
      --canvas: #f3f6f8;
      --surface: #ffffff;
      --surface-muted: #f7f9fa;
      --ink: #172329;
      --ink-soft: #55656c;
      --line: #dce4e7;
      --line-strong: #c9d4d9;
      --blue: #0d65d9;
      --blue-soft: #eaf2ff;
      --teal: #087e73;
      --teal-soft: #e2f5f1;
      --amber: #a46000;
      --amber-soft: #fff1d6;
      --red: #b83232;
      --red-soft: #fdeaea;
      --slate-soft: #edf1f3;
      --shadow: 0 1px 2px rgb(17 32 39 / 5%), 0 10px 28px rgb(17 32 39 / 5%);
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --content: 1440px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-width: 320px;
      background: var(--canvas);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 15px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    button, input { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; }
    a { color: var(--blue); }
    a:hover { color: #084fae; }
    code, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

    :focus-visible {
      outline: 3px solid rgb(13 101 217 / 35%);
      outline-offset: 2px;
    }

    .skip-link {
      position: fixed;
      z-index: 100;
      top: 8px;
      left: 8px;
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      background: var(--ink);
      color: #fff;
      transform: translateY(-160%);
    }
    .skip-link:focus { transform: translateY(0); }

    .shell {
      width: min(100% - 32px, var(--content));
      margin-inline: auto;
    }

    .topbar {
      border-bottom: 1px solid var(--line);
      background: rgb(255 255 255 / 88%);
      backdrop-filter: blur(14px);
    }

    .topbar__inner {
      min-height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--ink);
      font-weight: 750;
      letter-spacing: -.02em;
    }

    .brand__mark {
      display: grid;
      width: 32px;
      height: 32px;
      place-items: center;
      border-radius: 9px;
      background: var(--ink);
      color: #fff;
      font-size: 12px;
      letter-spacing: .04em;
    }

    .topbar__meta {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--ink-soft);
      font-size: 13px;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 28px;
      padding: 4px 9px;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 750;
      line-height: 1;
      text-transform: capitalize;
    }

    .status::before {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      content: "";
    }

    .status--completed { color: var(--teal); background: var(--teal-soft); }
    .status--started { color: var(--blue); background: var(--blue-soft); }
    .status--ready_to_resume { color: var(--blue); background: var(--blue-soft); }
    .status--stopped_budget { color: var(--amber); background: var(--amber-soft); }
    .status--failed { color: var(--red); background: var(--red-soft); }
    .status--unknown { color: var(--ink-soft); background: var(--slate-soft); }

    .hero { padding: 38px 0 26px; }
    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 24px;
    }

    .eyebrow {
      margin: 0 0 7px;
      color: var(--teal);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
    }

    h1, h2, h3, p { margin-top: 0; }
    h1 {
      max-width: 980px;
      margin-bottom: 12px;
      font-size: clamp(30px, 4vw, 54px);
      line-height: 1.05;
      letter-spacing: -.045em;
    }

    .hero__details {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin: 0;
      color: var(--ink-soft);
      font-size: 13px;
    }

    .hero__details span { white-space: nowrap; }
    .hero__details strong { color: var(--ink); font-weight: 650; }

    .log-link {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 9px 14px;
      border: 1px solid var(--line-strong);
      border-radius: 10px;
      background: var(--surface);
      box-shadow: 0 1px 2px rgb(17 32 39 / 4%);
      color: var(--ink);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }
    .log-link:hover { border-color: var(--blue); color: var(--blue); }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .stat, .card {
      border: 1px solid var(--line);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .stat {
      min-height: 116px;
      padding: 17px;
      border-radius: var(--radius-md);
    }

    .stat__label {
      margin-bottom: 18px;
      color: var(--ink-soft);
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .stat__value {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -.035em;
      line-height: 1;
    }

    .stat__hint { margin: 6px 0 0; color: var(--ink-soft); font-size: 12px; }

    main { padding-bottom: 64px; }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(300px, .85fr);
      align-items: start;
      gap: 16px;
    }

    .stack { display: grid; gap: 16px; }
    .card { overflow: hidden; border-radius: var(--radius-lg); }
    .card__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 22px 15px;
      border-bottom: 1px solid var(--line);
    }

    .card__header h2 {
      margin-bottom: 3px;
      font-size: 17px;
      letter-spacing: -.015em;
    }

    .card__header p { margin: 0; color: var(--ink-soft); font-size: 13px; }
    .card__body { padding: 20px 22px 22px; }

    .budget-list { display: grid; gap: 20px; }
    .budget__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 8px;
    }
    .budget__head strong { font-size: 13px; }
    .budget__head span { color: var(--ink-soft); font-size: 12px; }
    .bar {
      height: 9px;
      overflow: hidden;
      border-radius: 999px;
      background: var(--slate-soft);
    }
    .bar__fill { height: 100%; border-radius: inherit; background: var(--blue); }
    .bar__fill--teal { background: var(--teal); }
    .bar__fill--amber { background: #cc7800; }
    .budget__foot {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-top: 7px;
      color: var(--ink-soft);
      font-size: 11px;
    }

    .command {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      margin-top: 15px;
      padding: 13px 14px;
      border: 1px solid #bfd4f3;
      border-radius: var(--radius-sm);
      background: var(--blue-soft);
    }
    .command code { overflow-wrap: anywhere; color: #173b69; font-size: 12px; }
    .control-list { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
    .control-list span { padding: 5px 8px; border-radius: 7px; background: var(--slate-soft); color: var(--ink-soft); font-size: 11px; }

    .funnel { display: grid; gap: 16px; }
    .funnel__row {
      display: grid;
      grid-template-columns: minmax(105px, .8fr) minmax(130px, 1.7fr) auto;
      align-items: center;
      gap: 12px;
    }
    .funnel__label strong { display: block; font-size: 13px; }
    .funnel__label span { color: var(--ink-soft); font-size: 11px; }
    .funnel__value { min-width: 42px; text-align: right; font-weight: 800; }

    .provenance-list { display: grid; gap: 14px; }
    .provenance__row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px 12px;
      align-items: end;
    }
    .provenance__name { font-weight: 700; text-transform: capitalize; }
    .provenance__count { color: var(--ink-soft); font-size: 12px; }
    .provenance__bar { grid-column: 1 / -1; }

    .coverage {
      display: grid;
      grid-template-columns: 122px 1fr;
      align-items: center;
      gap: 22px;
    }
    .coverage__ring {
      --coverage: 0;
      display: grid;
      width: 122px;
      aspect-ratio: 1;
      place-items: center;
      border-radius: 50%;
      background: conic-gradient(var(--teal) calc(var(--coverage) * 1%), var(--slate-soft) 0);
      position: relative;
    }
    .coverage__ring::after {
      position: absolute;
      width: 90px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--surface);
      content: "";
    }
    .coverage__ring strong { z-index: 1; font-size: 24px; letter-spacing: -.035em; }
    .coverage__stats { display: grid; gap: 8px; }
    .coverage__stats div { display: flex; justify-content: space-between; gap: 12px; }
    .coverage__stats span { color: var(--ink-soft); }
    .coverage__stats strong { font-variant-numeric: tabular-nums; }

    .section { margin-top: 16px; }
    .section__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 10px;
      padding: 0 2px;
    }
    .section__header h2 { margin: 0; font-size: 19px; letter-spacing: -.02em; }
    .section__header p { margin: 2px 0 0; color: var(--ink-soft); font-size: 13px; }

    .toolbar { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-button {
      min-height: 36px;
      padding: 6px 11px;
      border: 1px solid var(--line-strong);
      border-radius: 9px;
      background: var(--surface);
      color: var(--ink-soft);
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
    }
    .filter-button[aria-pressed="true"] {
      border-color: var(--ink);
      background: var(--ink);
      color: #fff;
    }

    .search-field {
      width: min(100%, 310px);
      min-height: 38px;
      padding: 7px 11px;
      border: 1px solid var(--line-strong);
      border-radius: 9px;
      background: var(--surface);
      color: var(--ink);
    }
    .search-field::placeholder { color: #7d8a90; }

    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    th {
      padding: 11px 14px;
      border-bottom: 1px solid var(--line-strong);
      background: var(--surface-muted);
      color: var(--ink-soft);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .045em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    td { padding: 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:hover { background: #fbfcfd; }
    .cell-title { min-width: 230px; max-width: 460px; }
    .cell-title a, .cell-title strong { color: var(--ink); font-weight: 750; text-decoration: none; }
    .cell-title a:hover { color: var(--blue); text-decoration: underline; }
    .cell-title small, td small { display: block; margin-top: 4px; color: var(--ink-soft); }
    .reason { max-width: 540px; color: #34444b; }
    .number { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }

    .pill {
      display: inline-flex;
      align-items: center;
      min-height: 23px;
      padding: 3px 7px;
      border-radius: 999px;
      background: var(--slate-soft);
      color: #46565d;
      font-size: 11px;
      font-weight: 750;
      text-transform: capitalize;
      white-space: nowrap;
    }
    .pill--positive, .pill--available, .pill--executed { background: var(--teal-soft); color: var(--teal); }
    .pill--negative, .pill--failed, .pill--unavailable { background: var(--red-soft); color: var(--red); }
    .pill--planned, .pill--not_requested { background: var(--amber-soft); color: var(--amber); }
    .pill--deferred { background: var(--slate-soft); color: var(--ink-soft); }
    .pill--needs_transcript, .pill--deferred_budget { background: var(--amber-soft); color: var(--amber); }
    .pill--error { background: var(--red-soft); color: var(--red); }

    .empty {
      padding: 34px 22px;
      color: var(--ink-soft);
      text-align: center;
    }
    .empty strong { display: block; margin-bottom: 4px; color: var(--ink); }

    .errors { display: grid; gap: 10px; }
    .error {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4px 12px;
      padding: 13px 14px;
      border: 1px solid #efcccc;
      border-radius: var(--radius-sm);
      background: #fff8f8;
    }
    .error__stage { color: var(--red); font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
    .error__time { color: var(--ink-soft); font-size: 11px; text-align: right; }
    .error__message { grid-column: 1 / -1; margin: 0; color: #612b2b; overflow-wrap: anywhere; }

    .path-list { display: grid; gap: 10px; }
    .path {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--surface-muted);
    }
    .path__label { margin-bottom: 3px; color: var(--ink-soft); font-size: 11px; font-weight: 750; text-transform: uppercase; }
    .path code { display: block; overflow-wrap: anywhere; color: #304047; font-size: 11px; }
    .copy-button {
      min-width: 64px;
      min-height: 34px;
      padding: 5px 9px;
      border: 1px solid var(--line-strong);
      border-radius: 8px;
      background: var(--surface);
      color: var(--ink);
      cursor: pointer;
      font-size: 11px;
      font-weight: 750;
    }
    .copy-button:hover { border-color: var(--blue); color: var(--blue); }

    .file-list { margin: 14px 0 0; padding: 0; list-style: none; }
    .file-list li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid var(--line);
    }
    .file-list li:last-child { border-bottom: 0; }
    .file-list strong { display: block; font-size: 12px; }
    .file-list code { display: block; margin-top: 2px; color: var(--ink-soft); font-size: 10px; overflow-wrap: anywhere; }
    .file-list span { color: var(--ink-soft); font-size: 11px; text-align: right; white-space: nowrap; }

    .footer {
      padding: 18px 0 30px;
      border-top: 1px solid var(--line);
      color: var(--ink-soft);
      font-size: 11px;
    }
    .footer__inner { display: flex; justify-content: space-between; gap: 16px; }

    [hidden] { display: none !important; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    @media (max-width: 1100px) {
      .stats { grid-template-columns: repeat(3, 1fr); }
      .layout { grid-template-columns: 1fr; }
      .side-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .side-stack .card:last-child { grid-column: 1 / -1; }
    }

    @media (max-width: 720px) {
      .shell { width: min(100% - 20px, var(--content)); }
      .topbar__meta > span:not(.status) { display: none; }
      .hero { padding-top: 26px; }
      .hero__grid { grid-template-columns: 1fr; align-items: start; }
      .log-link { width: 100%; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .stat { min-height: 104px; padding: 14px; }
      .stat__label { margin-bottom: 14px; }
      .side-stack { grid-template-columns: 1fr; }
      .side-stack .card:last-child { grid-column: auto; }
      .card__header, .section__header { align-items: flex-start; flex-direction: column; }
      .card__header { padding: 17px 16px 13px; }
      .card__body { padding: 17px 16px 18px; }
      .funnel__row { grid-template-columns: minmax(90px, .8fr) minmax(100px, 1.5fr) auto; gap: 8px; }
      .coverage { grid-template-columns: 1fr; justify-items: center; }
      .coverage__stats { width: 100%; }
      .search-field { width: 100%; }
      .footer__inner { flex-direction: column; }
      .command { grid-template-columns: 1fr; }
    }

    @media (max-width: 420px) {
      .stats { grid-template-columns: 1fr 1fr; }
      .stat__value { font-size: 25px; }
      .hero__details { display: grid; gap: 5px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }

    @media print {
      body { background: #fff; }
      .topbar, .toolbar, .copy-button, .log-link { display: none !important; }
      .shell { width: 100%; }
      .card, .stat { break-inside: avoid; box-shadow: none; }
      .layout { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to dashboard</a>

  <header class="topbar">
    <div class="shell topbar__inner">
      <div class="brand"><span class="brand__mark" aria-hidden="true">YT</span> Research crawler</div>
      <div class="topbar__meta">
        <span>Project <span class="mono">{{ run.id | default('unknown', true) | e }}</span></span>
        <span class="status status--{{ status | e }}">{{ status | replace('_', ' ') | e }}</span>
      </div>
    </div>
  </header>

  <div class="shell">
    <section class="hero" aria-labelledby="run-title">
      <div class="hero__grid">
        <div>
          <p class="eyebrow">Research overview</p>
          <h1 id="run-title">{{ run.topic_query | default('Untitled topic', true) | e }}</h1>
          <p class="hero__details">
            <span><strong>Language</strong> {{ run.language | default('—', true) | e }}</span>
            <span><strong>Published since</strong> {{ run.start_date | default('—', true) | e }}</span>
            <span><strong>Duration</strong> {{ run.duration | default('In progress', true) | e }}</span>
            <span><strong>Model</strong> {{ run.model | default('—', true) | e }}</span>
            <span><strong>Sessions</strong> {{ run.sessions | default(0, true) }}</span>
          </p>
          {% if run.status_reason | default('', true) %}<p class="stat__hint">Latest stop: {{ run.status_reason | e }}</p>{% endif %}
        </div>
      </div>
    </section>

    <section class="stats" aria-label="Run metrics">
      <article class="stat"><p class="stat__label">Queries</p><p class="stat__value">{{ metrics.queries | default(0, true) }}</p><p class="stat__hint">planned variants</p></article>
      <article class="stat"><p class="stat__label">Candidates</p><p class="stat__value">{{ metrics.candidates | default(0, true) }}</p><p class="stat__hint">unique videos</p></article>
      <article class="stat"><p class="stat__label">Relevant</p><p class="stat__value">{{ metrics.relevant | default(0, true) }}</p><p class="stat__hint">accepted</p></article>
      <article class="stat"><p class="stat__label">Transcripts</p><p class="stat__value">{{ metrics.transcripts | default(0, true) }}</p><p class="stat__hint">available</p></article>
      <article class="stat"><p class="stat__label">Pending</p><p class="stat__value">{{ metrics.pending | default(0, true) }}</p><p class="stat__hint">videos awaiting work</p></article>
      <article class="stat"><p class="stat__label">Cache hits</p><p class="stat__value">{{ metrics.cache_hits | default(0, true) }}</p><p class="stat__hint">requests reused locally</p></article>
      <article class="stat"><p class="stat__label">Sessions</p><p class="stat__value">{{ run.sessions | default(0, true) }}</p><p class="stat__hint">start plus resumes</p></article>
      <article class="stat"><p class="stat__label">Errors</p><p class="stat__value">{{ metrics.errors | default(0, true) }}</p><p class="stat__hint">recorded events</p></article>
    </section>

    <main id="main-content">
      <div class="layout">
        <div class="stack">
          <section class="card" aria-labelledby="budget-heading">
            <header class="card__header">
              <div><h2 id="budget-heading">SearchAPI credit budget</h2><p>The first row is the project's cumulative lifetime grant; pool rows explain where it can be spent.</p></div>
            </header>
            <div class="card__body">
              {% if budgets %}
                <div class="budget-list">
                  {% for budget in budgets %}
                    <div class="budget">
                      <div class="budget__head"><strong>{{ budget.label | e }}</strong><span>{{ budget.used }} / {{ budget.limit }} {{ budget.unit | default('', true) | e }}</span></div>
                      <div class="bar" role="progressbar" aria-label="{{ budget.label | e }}" aria-valuemin="0" aria-valuemax="{{ budget.limit }}" aria-valuenow="{{ budget.used }}">
                        <div class="bar__fill bar__fill--{{ budget.tone | default('blue', true) | e }}" style="width: {{ budget.percent | default(0, true) }}%"></div>
                      </div>
                      <div class="budget__foot">
                        <span>{{ budget.percent | default(0, true) }}% used{% if budget.reserved | default(0, true) %} · {{ budget.reserved }} reserved{% endif %}</span>
                        <span>{{ budget.remaining | default(0, true) }} remaining</span>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <div class="empty"><strong>No budget events yet</strong>Usage will appear after the first operation.</div>
              {% endif %}
            </div>
          </section>

          <section class="card" aria-labelledby="continuation-heading">
            <header class="card__header">
              <div>
                {% if continuation.action | default('recover') == 'expand' %}
                  <h2 id="continuation-heading">Expand this completed project</h2>
                  <p>Expansion keeps the saved frontier and completed work, then widens one or more scope controls.</p>
                {% elif continuation.action | default('recover') == 'resume' %}
                  <h2 id="continuation-heading">Resume this project</h2>
                  <p>Resuming restores the saved frontier and reuses completed SearchAPI requests from this project.</p>
                {% else %}
                  <h2 id="continuation-heading">Project cannot be resumed</h2>
                  <p>A valid crawler checkpoint is required before any continuation command is safe.</p>
                {% endif %}
              </div>
            </header>
            <div class="card__body">
              <div class="control-list" aria-label="Current crawl controls">
                <span>depth {{ continuation.controls.max_depth | default(0) }}</span>
                <span>queries {{ continuation.controls.max_queries | default(0) }}</span>
                <span>search pages {{ continuation.controls.max_search_pages | default(0) }}</span>
                <span>channel pages {{ continuation.controls.max_channel_pages | default(0) }}</span>
                <span>{{ continuation.deferred_videos | default(0, true) }} deferred videos</span>
                <span>Executed queries: {{ continuation.executed_queries | default(0, true) }}</span>
                <span>Held by max_queries: {{ continuation.deferred_queries | default(0, true) }}</span>
                <span>Unfinished within current limits: {{ continuation.unfinished_queries | default(0, true) }}</span>
              </div>
              {% if continuation.resume_command | default('', true) %}
                <p class="stat__hint">{{ continuation.recommendation_reason | default('Suggested continuation command for this existing project.', true) | e }}</p>
                <div class="command"><code>{{ continuation.resume_command | e }}</code><button class="copy-button" type="button" data-copy="{{ continuation.resume_command | e }}">Copy</button></div>
              {% elif continuation.checkpoint_available | default(false) %}
                <p class="stat__hint">{{ continuation.recommendation_reason | default('All expansion controls are already at their CLI limits.', true) | e }}</p>
              {% else %}
                <p class="stat__hint">{{ continuation.checkpoint_message | default('No valid resumable checkpoint is available. Start again with a new project path.', true) | e }}</p>
              {% endif %}
              {% if sessions %}
                <div class="table-wrap" style="margin-top: 18px">
                  <table>
                    <caption>Project crawl sessions</caption>
                    <thead><tr><th>Session</th><th>Action</th><th>Time</th><th class="number">Added</th><th class="number">Lifetime grant</th><th>Controls</th></tr></thead>
                    <tbody>
                      {% for session in sessions %}
                        <tr>
                          <td>{{ loop.index }}</td>
                          <td><span class="pill pill--{{ 'executed' if session.action == 'start' else 'planned' }}">{{ session.action | e }}</span></td>
                          <td>{{ session.recorded_at | default('—', true) | e }}</td>
                          <td class="number">{{ session.credits_added | default(0, true) }}</td>
                          <td class="number">{{ session.lifetime_grant | default('—', true) }}</td>
                          <td>depth {{ session.max_depth }}, queries {{ session.max_queries }}, search pages {{ session.max_search_pages }}, channel pages {{ session.max_channel_pages }}, retries {{ session.searchapi_retries | default(0, true) }}</td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% endif %}
            </div>
          </section>

          <section class="card" aria-labelledby="funnel-heading">
            <header class="card__header">
              <div><h2 id="funnel-heading">Discovery funnel</h2><p>From broad discovery to collected transcripts.</p></div>
            </header>
            <div class="card__body">
              {% if funnel %}
                <div class="funnel">
                  {% for stage in funnel %}
                    <div class="funnel__row">
                      <div class="funnel__label"><strong>{{ stage.label | e }}</strong><span>{{ stage.hint | default('', true) | e }}</span></div>
                      <div class="bar" role="progressbar" aria-label="{{ stage.label | e }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ stage.percent | default(0, true) }}"><div class="bar__fill bar__fill--teal" style="width: {{ stage.percent | default(0, true) }}%"></div></div>
                      <div class="funnel__value">{{ stage.count | default(0, true) }}</div>
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <div class="empty"><strong>No candidates yet</strong>The funnel fills as sources are explored.</div>
              {% endif %}
            </div>
          </section>
        </div>

        <aside class="stack side-stack" aria-label="Run summaries">
          <section class="card" aria-labelledby="provenance-heading">
            <header class="card__header"><div><h2 id="provenance-heading">Provenance</h2><p>Where candidates were found.</p></div></header>
            <div class="card__body">
              {% if provenance %}
                <div class="provenance-list">
                  {% for source in provenance %}
                    <div class="provenance__row">
                      <span class="provenance__name">{{ source.source | replace('_', ' ') | e }}</span>
                      <span class="provenance__count">{{ source.count }} videos · {{ source.relevant }} relevant</span>
                      <div class="bar provenance__bar" role="progressbar" aria-label="{{ source.source | e }} share" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ source.percent | default(0, true) }}"><div class="bar__fill" style="width: {{ source.percent | default(0, true) }}%"></div></div>
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                <div class="empty"><strong>No provenance yet</strong>Sources will appear here.</div>
              {% endif %}
            </div>
          </section>

          <section class="card" aria-labelledby="coverage-heading">
            <header class="card__header"><div><h2 id="coverage-heading">Transcript coverage</h2><p>Availability among relevant videos.</p></div></header>
            <div class="card__body">
              <div class="coverage">
                <div class="coverage__ring" style="--coverage: {{ transcript.coverage_percent | default(0, true) }}" role="img" aria-label="{{ transcript.coverage_percent | default(0, true) }} percent transcript coverage"><strong>{{ transcript.coverage_percent | default(0, true) }}%</strong></div>
                <div class="coverage__stats">
                  <div><span>Eligible</span><strong>{{ transcript.eligible | default(0, true) }}</strong></div>
                  <div><span>Available</span><strong>{{ transcript.available | default(0, true) }}</strong></div>
                  <div><span>Unavailable</span><strong>{{ transcript.unavailable | default(0, true) }}</strong></div>
                  <div><span>Segments</span><strong>{{ transcript.segments | default(0, true) }}</strong></div>
                  <div><span>Words</span><strong>{{ transcript.words | default(0, true) }}</strong></div>
                </div>
              </div>
            </div>
          </section>

          <section class="card" aria-labelledby="paths-heading">
            <header class="card__header"><div><h2 id="paths-heading">Project data</h2><p>Local cumulative outputs for reproducible analysis.</p></div></header>
            <div class="card__body">
              <div class="path-list">
                <div class="path">
                  <div><div class="path__label">Project directory</div><code>{{ paths.run_dir | default('—', true) | e }}</code></div>
                  {% if paths.run_dir | default('', true) %}<button class="copy-button" type="button" data-copy="{{ paths.run_dir | e }}">Copy</button>{% endif %}
                </div>
                {% if paths.database | default('', true) %}
                  <div class="path">
                    <div><div class="path__label">DuckDB database</div><code>{{ paths.database | e }}</code></div>
                    <button class="copy-button" type="button" data-copy="{{ paths.database | e }}">Copy</button>
                  </div>
                {% endif %}
              </div>
              {% if jsonl_files %}
                <ul class="file-list" aria-label="JSONL files">
                  {% for file in jsonl_files %}
                    <li><div><strong>{{ file.name | e }}</strong><code>{{ file.path | e }}</code></div><span>{{ file.rows | default(0, true) }} rows{% if file.bytes | default('', true) %} · {{ file.bytes | e }}{% endif %}</span></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </section>
        </aside>
      </div>

      <section class="section" aria-labelledby="queries-heading">
        <header class="section__header">
          <div><h2 id="queries-heading">Query plan</h2><p>Every planned, executed, and deferred search.</p></div>
          {% if queries %}<label><span class="sr-only">Filter queries</span><input class="search-field" id="query-search" type="search" placeholder="Filter queries…" autocomplete="off"></label>{% endif %}
        </header>
        <div class="card">
          {% if queries %}
            <div class="table-wrap">
              <table>
                <caption>Search query plan and results</caption>
                <thead><tr><th scope="col">Query</th><th scope="col">Kind</th><th scope="col">Status</th><th scope="col" class="number">Results</th><th scope="col" class="number">Relevant</th></tr></thead>
                <tbody id="query-rows">
                  {% for query in queries %}
                    <tr data-query-row data-search="{{ (query.query ~ ' ' ~ query.kind ~ ' ' ~ query.status) | lower | e }}">
                      <td class="cell-title"><strong>{{ query.query | e }}</strong></td>
                      <td><span class="pill">{{ query.kind | replace('_', ' ') | e }}</span></td>
                      <td><span class="pill pill--{{ query.status | e }}">{{ query.status | replace('_', ' ') | e }}</span></td>
                      <td class="number">{{ query.results | default(0, true) }}</td><td class="number">{{ query.relevant | default(0, true) }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <div class="empty" id="query-empty" hidden><strong>No matching queries</strong>Try a different search term.</div>
          {% else %}
            <div class="empty"><strong>No queries recorded</strong>This run has not started discovery.</div>
          {% endif %}
        </div>
      </section>

      <section class="section" aria-labelledby="decisions-heading">
        <header class="section__header">
          <div><h2 id="decisions-heading">Relevance decisions</h2><p>Auditable classifications at the recorded decision point.</p></div>
          {% if relevant_videos or irrelevant_videos or other_videos %}
            <div class="toolbar" role="group" aria-label="Filter relevance decisions">
              <button class="filter-button" type="button" data-decision-filter="all" aria-pressed="true">All ({{ relevant_videos | length + irrelevant_videos | length + other_videos | length }})</button>
              <button class="filter-button" type="button" data-decision-filter="relevant" aria-pressed="false">Relevant ({{ relevant_videos | length }})</button>
              <button class="filter-button" type="button" data-decision-filter="irrelevant" aria-pressed="false">Irrelevant ({{ irrelevant_videos | length }})</button>
              {% if other_videos %}<button class="filter-button" type="button" data-decision-filter="other" aria-pressed="false">Other ({{ other_videos | length }})</button>{% endif %}
            </div>
          {% endif %}
        </header>
        <div class="card">
          {% if relevant_videos or irrelevant_videos or other_videos %}
            <div class="table-wrap">
              <table>
                <caption>Video relevance decisions and primary reasons</caption>
                <thead><tr><th scope="col">Video</th><th scope="col">Decision</th><th scope="col">Point</th><th scope="col">Primary reason</th><th scope="col">Transcript</th></tr></thead>
                <tbody>
                  {% for video in relevant_videos %}
                    <tr data-decision-row="relevant">
                      <td class="cell-title">{% if video.url | default('', true) %}<a href="{{ video.url | e }}" rel="noreferrer">{{ video.title | e }}</a>{% else %}<strong>{{ video.title | e }}</strong>{% endif %}<small>{{ video.channel | default('Unknown channel', true) | e }} · {{ video.published_at | default('Unknown date', true) | e }} · via {{ video.discovered_via | default('unknown', true) | replace('_', ' ') | e }}</small></td>
                      <td><span class="pill pill--positive">Relevant</span><small>{{ video.language | default('language unknown', true) | e }}</small></td>
                      <td><span class="pill">{{ video.decision_point | default('—', true) | replace('_', ' ') | e }}</span></td>
                      <td class="reason">{{ video.primary_reason | default('No reason recorded.', true) | e }}</td>
                      <td><span class="pill pill--{{ video.transcript_status | default('not_requested', true) | e }}">{{ video.transcript_status | default('not requested', true) | replace('_', ' ') | e }}</span></td>
                    </tr>
                  {% endfor %}
                  {% for video in irrelevant_videos %}
                    <tr data-decision-row="irrelevant">
                      <td class="cell-title">{% if video.url | default('', true) %}<a href="{{ video.url | e }}" rel="noreferrer">{{ video.title | e }}</a>{% else %}<strong>{{ video.title | e }}</strong>{% endif %}<small>{{ video.channel | default('Unknown channel', true) | e }} · {{ video.published_at | default('Unknown date', true) | e }} · via {{ video.discovered_via | default('unknown', true) | replace('_', ' ') | e }}</small></td>
                      <td><span class="pill pill--negative">Irrelevant</span><small>{{ video.language | default('language unknown', true) | e }}</small></td>
                      <td><span class="pill">{{ video.decision_point | default('—', true) | replace('_', ' ') | e }}</span></td>
                      <td class="reason">{{ video.primary_reason | default('No reason recorded.', true) | e }}</td>
                      <td><span class="pill pill--{{ video.transcript_status | default('not_requested', true) | e }}">{{ video.transcript_status | default('not requested', true) | replace('_', ' ') | e }}</span></td>
                    </tr>
                  {% endfor %}
                  {% for video in other_videos %}
                    <tr data-decision-row="other">
                      <td class="cell-title">{% if video.url | default('', true) %}<a href="{{ video.url | e }}" rel="noreferrer">{{ video.title | e }}</a>{% else %}<strong>{{ video.title | e }}</strong>{% endif %}<small>{{ video.channel | default('Unknown channel', true) | e }} · {{ video.published_at | default('Unknown date', true) | e }} · via {{ video.discovered_via | default('unknown', true) | replace('_', ' ') | e }}</small></td>
                      <td><span class="pill pill--{{ video.decision_label | default('pending', true) | e }}">{{ video.decision_display | default('pending', true) | e }}</span><small>{{ video.language | default('language unknown', true) | e }}</small></td>
                      <td><span class="pill">{{ video.decision_point | default('—', true) | replace('_', ' ') | e }}</span></td>
                      <td class="reason">{{ video.primary_reason | default('No reason recorded.', true) | e }}</td>
                      <td><span class="pill pill--{{ video.transcript_status | default('not_requested', true) | e }}">{{ video.transcript_status | default('not requested', true) | replace('_', ' ') | e }}</span></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="empty"><strong>No decisions recorded</strong>Classifications will appear with their primary reason and decision point.</div>
          {% endif %}
        </div>
      </section>

      <section class="section" aria-labelledby="transcripts-heading">
        <header class="section__header"><div><h2 id="transcripts-heading">Transcript inventory</h2><p>Coverage details for accepted videos.</p></div></header>
        <div class="card">
          {% if transcript_items %}
            <div class="table-wrap">
              <table>
                <caption>Transcript collection status</caption>
                <thead><tr><th scope="col">Video</th><th scope="col">Status</th><th scope="col">Language</th><th scope="col" class="number">Segments</th><th scope="col" class="number">Words</th><th scope="col">Note</th></tr></thead>
                <tbody>
                  {% for item in transcript_items %}
                    <tr><td class="cell-title"><strong>{{ item.title | e }}</strong><small class="mono">{{ item.video_id | e }}</small></td><td><span class="pill pill--{{ item.status | e }}">{{ item.status | replace('_', ' ') | e }}</span></td><td>{{ item.language | default('—', true) | e }}</td><td class="number">{{ item.segments | default(0, true) }}</td><td class="number">{{ item.words | default(0, true) }}</td><td class="reason">{{ item.reason | default('—', true) | e }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="empty"><strong>No transcript records</strong>Accepted videos are transcribed before discovery continues.</div>
          {% endif %}
        </div>
      </section>

      <section class="section" aria-labelledby="errors-heading">
        <header class="section__header"><div><h2 id="errors-heading">Errors and warnings</h2><p>Recorded failures are retained for audit and retry.</p></div></header>
        <div class="card"><div class="card__body">
          {% if errors %}
            <div class="errors">
              {% for error in errors %}
                <article class="error"><span class="error__stage">{{ error.stage | default('crawler', true) | e }}</span><time class="error__time">{{ error.recorded_at | default('—', true) | e }}</time><p class="error__message">{{ error.message | e }}{% if error.ref | default('', true) %} <span class="mono">({{ error.ref | e }})</span>{% endif %}</p></article>
              {% endfor %}
            </div>
          {% else %}
            <div class="empty"><strong>No errors recorded</strong>This project completed its recorded steps cleanly.</div>
          {% endif %}
        </div></div>
      </section>
    </main>
  </div>

  <footer class="footer">
    <div class="shell footer__inner"><span>Generated {{ dashboard.generated_at | default('—', true) | e }}</span><span>Project <span class="mono">{{ run.id | default('unknown', true) | e }}</span> · prompt {{ run.prompt_version | default('—', true) | e }}{% if run.prompt_sha256 | default('', true) %} · hash <span class="mono" title="{{ run.prompt_sha256 | e }}">{{ run.prompt_sha256[:12] | e }}</span>{% endif %}</span></div>
  </footer>

  <script>
    (() => {
      const queryInput = document.querySelector('#query-search');
      const queryRows = [...document.querySelectorAll('[data-query-row]')];
      const queryEmpty = document.querySelector('#query-empty');
      if (queryInput) {
        queryInput.addEventListener('input', () => {
          const needle = queryInput.value.trim().toLocaleLowerCase();
          let visible = 0;
          queryRows.forEach((row) => {
            const match = !needle || row.dataset.search.includes(needle);
            row.hidden = !match;
            if (match) visible += 1;
          });
          if (queryEmpty) queryEmpty.hidden = visible !== 0;
        });
      }

      const decisionButtons = [...document.querySelectorAll('[data-decision-filter]')];
      const decisionRows = [...document.querySelectorAll('[data-decision-row]')];
      decisionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.decisionFilter;
          decisionButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
          decisionRows.forEach((row) => { row.hidden = filter !== 'all' && row.dataset.decisionRow !== filter; });
        });
      });

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          try {
            await navigator.clipboard.writeText(value);
            button.textContent = 'Copied';
          } catch (_error) {
            const input = document.createElement('textarea');
            input.value = value;
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.append(input);
            input.select();
            document.execCommand('copy');
            input.remove();
            button.textContent = 'Copied';
          }
          window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
        });
      });
    })();
  </script>
</body>
</html>
